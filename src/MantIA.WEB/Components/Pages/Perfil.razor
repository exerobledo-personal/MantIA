@page "/perfil"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using MantIA.WEB.Services
@using MantIA.DAL.Tenancy
@inject AuthenticationStateProvider AuthProvider
@inject TenantResolver Resolver

<h3>Perfil de sesion</h3>

@if (claims is null)
{
    <p>Cargando...</p>
}
else if (claims.Count == 0)
{
    <p>No estas autenticado. <a href="/login">Iniciar sesion</a></p>
}
else
{
    <p><strong>Empresa (tenant) resuelta:</strong> @(empresaId?.ToString() ?? "NINGUNA (fail-closed)")</p>
    <hr />
    <ul>
        @foreach (var c in claims)
        {
            <li><strong>@c.Type</strong>: @c.Value</li>
        }
    </ul>
    <a href="/logout">Cerrar sesion</a>
}

@code {
    private List<Claim>? claims;
    private Guid? empresaId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        claims = state.User.Claims.ToList();

        if (claims.Count > 0)
        {
            await Resolver.ResolverAsync(state.User);
            // leemos el tenant ya resuelto desde el mismo scope
            empresaId = (await AuthProvider.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true
                ? GetTenant()
                : null;
        }
    }

    [Inject] private ICurrentTenant Tenant { get; set; } = default!;
    private Guid? GetTenant() => Tenant.EmpresaId;
}