@page "/perfil"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using MantIA.WEB.Services
@inject AuthenticationStateProvider AuthProvider
@inject TenantResolver Resolver

<h3>Perfil de sesion</h3>

@if (claims is null)
{
    <p>Cargando...</p>
}
else if (claims.Count == 0)
{
    <p>No estas autenticado. <a href="/login">Iniciar sesion</a></p>
}
else
{
    <p><strong>Estado de acceso:</strong> @resultado?.Estado</p>
    @if (!string.IsNullOrEmpty(resultado?.Mensaje))
    {
        <p style="color:red"><strong>@resultado!.Mensaje</strong></p>
    }
    <p><strong>Empresa (tenant) resuelta:</strong> @(resultado?.EmpresaId?.ToString() ?? "NINGUNA")</p>
    <hr />
    <ul>
        @foreach (var c in claims)
        {
            <li><strong>@c.Type</strong>: @c.Value</li>
        }
    </ul>
    <a href="/logout">Cerrar sesion</a>
}

@code {
    private List<Claim>? claims;
    private ResultadoAcceso? resultado;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        claims = state.User.Claims.ToList();
        if (claims.Count > 0)
            resultado = await Resolver.ResolverAsync(state.User);
    }
}