@using Microsoft.AspNetCore.Components.Authorization
@using MantIA.WEB.Services
@using MantIA.BLL.Acceso
@inject AuthenticationStateProvider AuthProvider
@inject TenantResolver Resolver
@inject NavigationManager Nav

@ChildContent

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();

        // Si no esta autenticado, no hacemos nada: las paginas publicas siguen accesibles.
        if (state.User.Identity?.IsAuthenticated != true)
            return;

        // Esta autenticado: validamos que tenga acceso real (usuario + dominio).
        var resultado = await Resolver.ResolverAsync(state.User);

        if (!resultado.Autorizado)
        {
            var msg = Uri.EscapeDataString(resultado.Mensaje ?? "Acceso no autorizado.");
            Nav.NavigateTo($"/acceso-denegado?mensaje={msg}", forceLoad: true);
        }
    }
}