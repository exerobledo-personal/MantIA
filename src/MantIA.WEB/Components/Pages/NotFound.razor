@page "/not-found"
@layout LoginLayout

<PageTitle>Página no encontrada · MantIA</PageTitle>

<div class="mantia-acceso__panel" style="min-height:100vh">
    <div style="width:100%;max-width:560px;text-align:center">
        <div class="d-flex align-center justify-center mb-6" style="gap:.75rem">
            <MudIcon Icon="@Icons.Material.Filled.Insights" Color="Color.Primary" />
            <MudText Typo="Typo.h6">MantIA</MudText>
        </div>

        <MudText Typo="Typo.h1" Color="Color.Primary" Style="font-size:6rem;font-weight:700;line-height:1">
            404
        </MudText>

        <MudText Typo="Typo.h4" Class="mt-2">No encontramos esta página</MudText>

        <MudText Typo="Typo.body1" Class="mt-3">
            La dirección que abriste no corresponde a ninguna pantalla de la plataforma.
        </MudText>

        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-4">
            Puede que el enlace esté mal escrito, que el registro que buscabas haya sido dado de baja o que la
            pantalla ya no exista. Desde el panel principal vas a encontrar el acceso a las máquinas, los repuestos
            críticos, las órdenes de trabajo y los reportes.
        </MudText>

        <div class="d-flex flex-wrap justify-center mt-6" style="gap:.75rem">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.SpaceDashboard" Href="/dashboard">
                Ir al panel principal
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Login" Href="/">
                Volver al inicio de sesión
            </MudButton>
        </div>
    </div>
</div>
