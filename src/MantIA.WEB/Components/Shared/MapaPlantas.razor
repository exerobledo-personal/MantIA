@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="mantia-mapa">
    <div @ref="_contenedor" class="mantia-mapa__lienzo"></div>

    @if (!_cargado)
    {
        <div class="mantia-mapa__cargando">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
            <span>Cargando el mapa…</span>
        </div>
    }

    @if (_fallo)
    {
        <div class="mantia-mapa__sinmapa">
            <MudIcon Icon="@Icons.Material.Outlined.MapsHomeWork" Size="Size.Large" />
            <p>No se pudo cargar el mapa</p>
            <span>Las imágenes del mapa se descargan en línea: revisá la conexión.</span>
        </div>
    }

    @if (Plantas.Count > 0)
    {
        <ul class="mantia-mapa__leyenda">
            @foreach (var planta in Plantas)
            {
                var activa = PlantaSeleccionada?.Id == planta.Id;
                <li>
                    <button type="button"
                            class="@(activa ? "mantia-mapa__chip mantia-mapa__chip--activo" : "mantia-mapa__chip")"
                            @onclick="@(() => Seleccionar(planta))">
                        <span class="mantia-mapa__punto mantia-mapa__punto--@Severidad(planta)"></span>
                        @planta.Nombre
                        <span class="mantia-mapa__conteo">@planta.Maquinas</span>
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<PlantaVm> Plantas { get; set; } = [];
    [Parameter] public PlantaVm? PlantaSeleccionada { get; set; }
    [Parameter] public EventCallback<PlantaVm> PlantaSeleccionadaChanged { get; set; }

    private ElementReference _contenedor;
    private IJSObjectReference? _modulo;
    private DotNetObjectReference<MapaPlantas>? _referencia;
    private bool _cargado;
    private bool _fallo;
    private string _firmaPrevia = "";

    protected override async Task OnAfterRenderAsync(bool primeraVez)
    {
        if (_fallo) return;

        var firma = Firma();

        try
        {
            if (primeraVez)
            {
                _modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/mapa-plantas.js");
                _referencia = DotNetObjectReference.Create(this);
                await _modulo.InvokeVoidAsync("crear", _contenedor, Puntos(), _referencia);

                _cargado = true;
                _firmaPrevia = firma;
                StateHasChanged();
                return;
            }

            if (_modulo is null || firma == _firmaPrevia) return;

            _firmaPrevia = firma;
            await _modulo.InvokeVoidAsync("actualizar", _contenedor, Puntos());
        }
        catch (JSDisconnectedException)
        {
            // El circuito se cerro mientras se dibujaba el mapa: no hay nada que hacer.
        }
        catch (JSException)
        {
            _fallo = true;
            _cargado = true;
            StateHasChanged();
        }
    }

    /// <summary>Devuelve al componente padre el clic sobre un marcador del mapa.</summary>
    [JSInvokable]
    public async Task SeleccionarDesdeMapa(Guid id)
    {
        var planta = Plantas.FirstOrDefault(p => p.Id == id);
        if (planta is not null) await Seleccionar(planta);
    }

    private Task Seleccionar(PlantaVm planta) => PlantaSeleccionadaChanged.InvokeAsync(planta);

    // Evita redibujar el mapa en cada render: solo cuando cambia algo que el mapa muestra.
    private string Firma() =>
        string.Join('|', Plantas.Select(p =>
            $"{p.Id}:{p.Latitud}:{p.Longitud}:{p.Maquinas}:{p.AlertasActivas}:{p.OrdenesAbiertas}:{p.Nombre}"))
        + $"#{PlantaSeleccionada?.Id}";

    private object[] Puntos() => Plantas.Select(p => (object)new
    {
        id = p.Id,
        nombre = p.Nombre,
        localidad = p.Localidad,
        latitud = (double)p.Latitud,
        longitud = (double)p.Longitud,
        maquinas = p.Maquinas,
        alertas = p.AlertasActivas,
        ordenes = p.OrdenesAbiertas,
        severidad = Severidad(p),
        seleccionada = PlantaSeleccionada?.Id == p.Id
    }).ToArray();

    private static string Severidad(PlantaVm planta) => planta.AlertasActivas switch
    {
        >= 4 => "critico",
        >= 1 => "atencion",
        _ => "normal"
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_modulo is not null)
            {
                await _modulo.InvokeVoidAsync("destruir", _contenedor);
                await _modulo.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        _referencia?.Dispose();
    }
}
