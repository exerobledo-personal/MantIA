@implements IDisposable

<MudNavMenu Class="mantia-nav">
    <MudNavLink Href="@Sesion.RutaInicio(Sesion.Actual)" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.SpaceDashboard">
        @Idioma.T("nav.panel")
    </MudNavLink>

    @if (Sesion.PuedeVer(Modulo.Operacion))
    {
        <div class="mantia-nav__seccion">@Idioma.T("nav.operacion")</div>
        <MudNavLink Href="/maquinas" Icon="@Icons.Material.Filled.PrecisionManufacturing">@Idioma.T("nav.maquinas")</MudNavLink>
        <MudNavLink Href="/repuestos" Icon="@Icons.Material.Filled.Inventory2">@Idioma.T("nav.repuestos")</MudNavLink>
        <MudNavLink Href="/alertas" Icon="@Icons.Material.Filled.WarningAmber">@Idioma.T("nav.alertas")</MudNavLink>
        <MudNavLink Href="/ordenes" Icon="@Icons.Material.Filled.Assignment">@Idioma.T("nav.ordenes")</MudNavLink>
        <MudNavLink Href="/catalogo" Icon="@Icons.Material.Filled.MenuBook">@Idioma.T("nav.catalogo")</MudNavLink>
    }

    @if (Sesion.PuedeVer(Modulo.Recomendaciones))
    {
        <MudNavLink Href="/recomendaciones" Icon="@Icons.Material.Filled.Psychology">@Idioma.T("nav.recomendaciones")</MudNavLink>
    }

    @if (Sesion.PuedeVer(Modulo.Reportes))
    {
        <MudNavLink Href="/reportes" Icon="@Icons.Material.Filled.Analytics">@Idioma.T("nav.reportes")</MudNavLink>
    }

    @if (Sesion.PuedeVer(Modulo.AdministracionEmpresa))
    {
        <div class="mantia-nav__seccion">@Idioma.T("nav.empresa")</div>
        <MudNavLink Href="/empresa" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Business">@Idioma.T("nav.panelEmpresa")</MudNavLink>
        <MudNavLink Href="/empresa/usuarios" Icon="@Icons.Material.Filled.Group">@Idioma.T("nav.usuarios")</MudNavLink>
        <MudNavLink Href="/empresa/plantas" Icon="@Icons.Material.Filled.Factory">@Idioma.T("nav.plantas")</MudNavLink>
        <MudNavLink Href="/empresa/mapa" Icon="@Icons.Material.Filled.Map">@Idioma.T("nav.mapa")</MudNavLink>
        <MudNavLink Href="/empresa/permisos" Icon="@Icons.Material.Filled.AdminPanelSettings">@Idioma.T("nav.permisos")</MudNavLink>
        <MudNavLink Href="/empresa/bitacora" Icon="@Icons.Material.Filled.History">@Idioma.T("nav.bitacora")</MudNavLink>
    }

    @if (Sesion.PuedeVer(Modulo.Plataforma))
    {
        <div class="mantia-nav__seccion">@Idioma.T("nav.plataforma")</div>
        <MudNavLink Href="/plataforma" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Hub">@Idioma.T("nav.panelPlataforma")</MudNavLink>
        <MudNavLink Href="/plataforma/empresas" Icon="@Icons.Material.Filled.Domain">@Idioma.T("nav.empresas")</MudNavLink>
        <MudNavLink Href="/plataforma/planes" Icon="@Icons.Material.Filled.Sell">@Idioma.T("nav.planes")</MudNavLink>
        <MudNavLink Href="/plataforma/sistema" Icon="@Icons.Material.Filled.MonitorHeart">@Idioma.T("nav.sistema")</MudNavLink>
    }

    <div class="mantia-nav__pie">
        <MudNavLink Href="/mi-perfil" Icon="@Icons.Material.Filled.AccountCircle">@Idioma.T("nav.perfil")</MudNavLink>
    </div>
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        Sesion.Cambio += Refrescar;
        Idioma.Cambio += Refrescar;
    }

    public void Dispose()
    {
        Sesion.Cambio -= Refrescar;
        Idioma.Cambio -= Refrescar;
    }

    private void Refrescar() => InvokeAsync(StateHasChanged);
}
